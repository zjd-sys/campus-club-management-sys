# ===== 门户前端环境变量示例 =====
# 复制为 .env.development / .env.production 或 .env.local 后按需修改。
# 所有项均为「可选」：不配置时使用相对路径 + 开发代理，开箱即用。

# 后端接口基址。缺省 /api/portal（同源相对路径，由反向代理或开发代理转发）
VITE_API_BASE_URL=/api/portal

# 静态文件（图片/视频/文档）基址。留空表示同源相对路径；
# 若文件托管在独立域名 / CDN / 对象存储，填完整前缀，如 https://cdn.example.com
VITE_FILE_BASE_URL=

# —— 仅开发环境（vite dev server）生效 ——
VITE_DEV_PROXY_TARGET=http://localhost:8080
VITE_DEV_PORT=5173
